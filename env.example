# Vercel Project > Settings > Environment Variables (DO NOT COMMIT REAL VALUES)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional only when using an API key that is not tied to a single workspace:
ANTHROPIC_WORKSPACE_ID=
# Your own separate access code, at least 10 characters (not the API key):
DEMO_ACCESS_CODE=
# Optional; GitHub Pages origin is permitted by server by default:
ALLOWED_ORIGINS=https://eunyoung0120choi-cpu.github.io
